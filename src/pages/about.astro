---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import HeroSimple from "../components/HeroSimple.astro";
import { brand, services, trustPoints } from "../data/site";

const overviewFacts = ["31 Years of Industry Experience", "Kuala Lumpur & Selangor", "Residential & Commercial Roofs"];

const workSteps = [
  {
    title: "Share the Issue",
    text: "Call or WhatsApp with your location, photos, and details of the roof leak or waterproofing concern.",
  },
  {
    title: "Inspect & Recommend",
    text: "Our team checks the roof condition, explains the likely cause, and recommends a practical repair scope before quotation.",
  },
  {
    title: "Quote Clearly",
    text: "A clear quotation is provided before work begins, with cost-conscious options where possible and no hidden charges.",
  },
  {
    title: "Repair & Support",
    text: "Our roofing team completes the agreed repair, installation, or waterproofing work and checks the finished area.",
  },
];
---
<BaseLayout
  title="About"
  description="Learn about Perfect Roofing & Waterproofing and our roof repair, installation, maintenance, and waterproofing services in Kuala Lumpur and Selangor."
  path="/about"
>
  <HeroSimple label="about us" title="About Perfect Roofing & Waterproofing" subtitle="Roofing and waterproofing specialists helping homes and businesses across Kuala Lumpur and Selangor." />

  <section class="about-overview-section padding-bottom">
    <div class="w-layout-blockcontainer container w-container">
      <div class="about-overview-grid" style="opacity:1">
        <div class="about-overview-content">
          <div class="title-wrapper">
            <h2 class="section-title">Roofing Solutions <span class="highlight-title">You Can Rely On</span></h2>
            <p class="section-subtitle about">Perfect Roofing & Waterproofing brings 31 years of industry experience to residential and commercial roofing and waterproofing needs. We serve property owners across Kuala Lumpur and Selangor.</p>
          </div>
          <p class="about-overview-text">From leak detection and maintenance to waterproofing and roof replacement, we inspect the site, explain the recommended solution, provide a clear quotation, and check the completed work.</p>
          <div class="about-fact-row">
            {overviewFacts.map((fact) => <span class="about-fact-chip">{fact}</span>)}
          </div>
        </div>
        <div class="about-overview-image-wrap">
          <img alt="Roof installation work by Perfect Roofing & Waterproofing" class="about-overview-image" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 620px" src="/images/man-working-roof-front-view.png" srcset="/images/man-working-roof-front-view-p-500.png 500w, /images/man-working-roof-front-view-p-800.png 800w, /images/man-working-roof-front-view.png 820w" />
        </div>
      </div>
    </div>
  </section>

  <section class="service-section section-padding">
    <div class="w-layout-blockcontainer container w-container">
      <div class="section-content-wrapper">
        <div class="title-wrapper style-02" style="opacity:1">
          <h2 class="section-title">Our Core Services</h2>
          <p class="section-subtitle">Explore six roofing and waterproofing services, from finding leaks and maintaining roofs to replacement, installation, and water leakage repair.</p>
        </div>
        <div class="about-service-grid" style="opacity:1">
          {services.map((service) => (
            <a class="about-service-card w-inline-block" href={service.href}>
              <div class="about-service-icon-wrap">
                <img alt="" class="about-service-icon" loading="lazy" src={service.hoverImage || "/images/Group-4.svg"} />
              </div>
              <div>
                <h4 class="choose-us-card-title">{service.title}</h4>
                <p class="choose-us-card-subtitle">{service.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="why-choose-us section-padding">
    <div class="w-layout-blockcontainer container w-container">
      <div class="section-content-wrapper">
        <div class="title-wrapper style-02" style="opacity:1">
          <h2 class="section-title">Why Customers Choose Us</h2>
          <p class="section-subtitle">Property owners choose our practical roof inspections, clear quotations, and roofing and waterproofing experience across Kuala Lumpur and Selangor.</p>
        </div>
        <div class="why-choose-card-wrapper" style="opacity:1">
          {trustPoints.map((point) => (
            <div class="single-choose-us-card">
              <h4 class="choose-us-card-title">{point.title}</h4>
              <p class="choose-us-card-subtitle">{point.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="how-it-works-section padding">
    <div class="w-layout-blockcontainer container-large how-it-works section-padding w-container">
      <div class="w-layout-blockcontainer container w-container">
        <div class="section-content-wrapper">
          <div class="title-wrapper style-02" style="opacity:1">
            <h2 class="section-title">How We Work</h2>
            <p class="section-subtitle">A clear process for roof leaks, planned roofing work, and waterproofing projects.</p>
          </div>
          <div class="about-process-grid" style="opacity:1">
            {workSteps.map((step, index) => (
              <div class="about-process-card">
                <span class="about-process-number">{String(index + 1).padStart(2, "0")}</span>
                <h4 class="choose-us-card-title">{step.title}</h4>
                <p class="choose-us-card-subtitle">{step.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA title="Need help with your roof?" text="Share your location and photos so Perfect Roofing & Waterproofing can advise the next inspection or quotation step." />
</BaseLayout>
