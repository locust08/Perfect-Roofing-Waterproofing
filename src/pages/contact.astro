---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import HeroSimple from "../components/HeroSimple.astro";
import { brand, contactTeams, officeContact } from "../data/site";
import { turnstileSiteKey } from "../data/security";

const whatsappHref = `https://wa.me/${brand.phone.replace(/\D/g, "")}`;
const iconPaths = {
  whatsapp: "M12 2a9.8 9.8 0 0 0-8.5 14.7L2.4 22l5.5-1.1A9.8 9.8 0 1 0 12 2Zm0 2a7.8 7.8 0 0 1 0 15.6 7.7 7.7 0 0 1-3.6-.9l-.3-.2-3 .6.6-2.9-.2-.3A7.8 7.8 0 0 1 12 4Zm-3 4.1c-.2 0-.5.1-.7.4-.2.3-.8.8-.8 2s.8 2.3.9 2.5c.1.2 1.6 2.6 4 3.5 2 .8 2.4.6 2.8.6.4 0 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1-.1-.1-.2-.2-.5-.3l-1.6-.8c-.2-.1-.4-.1-.6.1l-.7.9c-.1.2-.3.2-.5.1-.3-.1-1.1-.4-2-1.2-.7-.7-1.2-1.5-1.4-1.8-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.7-1.7c-.2-.4-.4-.4-.6-.4H9Z",
  roof: "M3 11 12 3l9 8-1.3 1.5L12 5.7 4.3 12.5 3 11Zm3 1h12v9H6v-9Zm2 2v5h8v-5H8Zm1-1.5 2-4h2l2 4h-2.2L12 11l-.8 1.5H9Z",
  waterproofing: "M12 2s7 7.1 7 12a7 7 0 0 1-14 0c0-4.9 7-12 7-12Zm0 3.1C9.8 7.6 7 11.4 7 14a5 5 0 0 0 10 0c0-2.6-2.8-6.4-5-8.9Zm-1 5.4h2v5h-2v-5Zm0 6h2v2h-2v-2Z",
};
---
<BaseLayout
  title="Contact Us"
  description="Contact Perfect Roofing & Waterproofing for roof repair, installation, maintenance, waterproofing, or water leakage repair across Kuala Lumpur and Selangor."
  path="/contact"
>
  <HeroSimple label="contact us" title="Get In Touch" subtitle="Need help with a roof leak or waterproofing problem? Contact Perfect Roofing & Waterproofing across Kuala Lumpur and Selangor." />

  <section class="contact-section padding-top">
    <div class="w-layout-blockcontainer container w-container">
      <div class="contact-card-wrapper">
        <div class="single-contact-card">
          <div class="contact-card-label-box contact-card-label-with-icon">
            <h4 class="contact-card-label">Call Us Directly</h4>
            <span class="contact-card-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24"><path d="M6.6 10.8c1.6 3.1 3.5 5 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1.3.4 2.6.7 4 .7.7 0 1.2.5 1.2 1.2v3.5c0 .7-.5 1.2-1.2 1.2C10.4 21.6 2.4 13.6 2.4 3.4c0-.7.5-1.2 1.2-1.2h3.5c.7 0 1.2.5 1.2 1.2 0 1.4.2 2.8.7 4 .1.4 0 .9-.3 1.2l-2.1 2.2Z" fill="currentColor"/></svg>
            </span>
          </div>
          <div class="contact-card-content">
            <div class="top-card-content"><p class="contact-card-title">Speak with our team today</p><p class="contact-card-subtitle">Call or WhatsApp about roof leaks, installation, maintenance, or waterproofing.</p></div>
            <div class="quick-contacts">
              <div class="single-quick-contact"><p class="quick-contact-label">Call / WhatsApp:</p><a class="quick-contact-link whatsapp-link" href={whatsappHref} target="_blank" rel="noopener">{brand.phone}</a></div>
            </div>
          </div>
        </div>
        <div class="single-contact-card active">
          <div class="contact-card-label-box active contact-card-label-with-icon">
            <h4 class="contact-card-label">Visit Our Office</h4>
            <span class="contact-card-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24"><path d="M12 21s7-5.3 7-12A7 7 0 1 0 5 9c0 6.7 7 12 7 12Zm0-9a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" fill="currentColor"/></svg>
            </span>
          </div>
          <div class="contact-card-content">
            <div class="top-card-content"><p class="contact-card-title active">Our Subang Jaya address</p><p class="contact-card-subtitle active">Call or WhatsApp first to arrange a consultation or site inspection.</p></div>
            <div class="quick-contacts"><p class="quick-contact-label active contact-address-text">{brand.address}</p></div>
          </div>
        </div>
        <div class="single-contact-card">
          <div class="contact-card-label-box contact-card-label-with-icon">
            <h4 class="contact-card-label">Service Coverage</h4>
            <span class="contact-card-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24"><path d="M12 21s7-5.3 7-12A7 7 0 1 0 5 9c0 6.7 7 12 7 12Zm0-9a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" fill="currentColor"/></svg>
            </span>
          </div>
          <div class="contact-card-content">
            <div class="top-card-content"><p class="contact-card-title">KL & Selangor roofing support</p><p class="contact-card-subtitle">Share your location and photos through WhatsApp or the enquiry form below.</p></div>
            <div class="quick-contacts"><div class="single-quick-contact"><p class="quick-contact-label">Service area:</p><p class="quick-contact-link">{brand.serviceArea}</p></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-teams-section section-padding">
    <div class="w-layout-blockcontainer container w-container">
      <div class="section-content-wrapper">
        <div class="title-wrapper style-02 align-center">
          <h2 class="section-title">Contact Our Roofing Team</h2>
          <p class="section-subtitle">One contact number for roof repair, installation, maintenance, and waterproofing enquiries.</p>
        </div>
        <div class="contact-teams-grid">
          {contactTeams.map((team) => (
            <article class="contact-team-card">
              <div class="contact-team-top">
                <span class="contact-team-icon" aria-hidden="true">
                  <svg width="34" height="34" viewBox="0 0 24 24"><path d={iconPaths[team.icon]} fill="currentColor" /></svg>
                </span>
                <div class="contact-team-heading">
                  <h3>{team.title}</h3>
                  <span class="copyable-contact">
                    <a href={team.call}>{team.number}</a>
                    <button class="contact-copy-button" type="button" data-copy-value={team.number} aria-label={`Copy ${team.title} phone number`}>
                      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M8 7V5a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3h-2v-2h2a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v2H8Zm-1 3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1H7Zm0-2h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3Z" fill="currentColor"/>
                      </svg>
                    </button>
                  </span>
                </div>
              </div>
              <div class="contact-team-actions">
                <a class="contact-team-button whatsapp-link" href={team.whatsapp} target="_blank" rel="noopener">
                  <span aria-hidden="true">WhatsApp</span>
                </a>
                <a class="contact-team-button mobile-call-button" href={team.call}>Call</a>
              </div>
              <p class="contact-team-source">Serving {brand.serviceArea}</p>
            </article>
          ))}
        </div>
        <article class="office-contact-card">
          <div class="office-contact-main">
            <span class="contact-team-icon office" aria-hidden="true">
              <svg width="34" height="34" viewBox="0 0 24 24"><path d="M4 21V3h10v6h6v12h-2v-2H6v2H4Zm2-4h2v-2H6v2Zm0-4h2v-2H6v2Zm0-4h2V7H6v2Zm4 8h2v-2h-2v2Zm0-4h2v-2h-2v2Zm0-4h2V7h-2v2Zm4 8h4v-6h-4v6Zm0-8h4v-2h-4v2Z" fill="currentColor"/></svg>
            </span>
            <div class="contact-team-heading">
              <h3>{officeContact.title}</h3>
              <span class="copyable-contact">
                <a href={officeContact.call}>{officeContact.number}</a>
                <button class="contact-copy-button" type="button" data-copy-value={officeContact.number} aria-label="Copy office phone number">
                  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 7V5a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3h-2v-2h2a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v2H8Zm-1 3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1H7Zm0-2h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3Z" fill="currentColor"/>
                  </svg>
                </button>
              </span>
              <p class="contact-team-source">WhatsApp +60 11-1188 8828</p>
            </div>
          </div>
          <div class="office-contact-details">
            <p>{officeContact.address}</p>
          </div>
          <a class="contact-team-button office-call mobile-call-button" href={officeContact.call}>Call</a>
        </article>
      </div>
    </div>
  </section>

  <section class="contact-section padding-top">
    <div class="w-layout-blockcontainer container w-container">
      <div class="section-content-wrapper">
        <div class="title-wrapper style-02 align-center">
          <h2 class="section-title">Get In Touch</h2>
          <p class="section-subtitle">Tell us about your roof or waterproofing concern. For urgent leaks, call or WhatsApp directly.</p>
        </div>
        <div class="contact-form-wrapper">
          <div class="contact-form-content">
            <div class="contact-form-block w-form">
              <form action="/api/enquiries" class="form" data-enquiry-form data-name="Contact Form" method="post" name="contact-form">
                <input name="form_type" type="hidden" value="contact" />
                <div class="field-row">
                  <div class="single-field-wrapper"><label for="contact-name">Name</label><input class="single-field w-input" id="contact-name" maxlength="100" name="name" placeholder="Enter full name" required type="text" /></div>
                  <div class="single-field-wrapper"><label for="contact-email">Email Address</label><input class="single-field w-input" id="contact-email" maxlength="254" name="email" placeholder="Enter email address (optional)" type="email" /></div>
                  <div class="single-field-wrapper"><label for="contact-phone">Phone Number</label><input class="single-field w-input" id="contact-phone" maxlength="30" name="phone" placeholder="Enter phone number" required type="tel" /></div>
                  <div class="single-field-wrapper"><label for="contact-service">Service</label><select class="single-field w-input" id="contact-service" name="service"><option value="">Not Sure / Need Inspection</option><option value="roof-leaking-waterproofing">Roof Leak Detection & Repair</option><option value="roof-leaking-waterproofing">Roof Replacement & Re-roofing</option><option value="roof-leaking-waterproofing">Roof Maintenance & Inspection</option><option value="roof-leaking-waterproofing">New Roof Installation</option><option value="roof-leaking-waterproofing">Roof Waterproofing</option><option value="roof-leaking-waterproofing">PU Injection & Water Leakage Repair</option></select></div>
                </div>
                <div class="single-field-wrapper"><label for="contact-message">Message</label><textarea class="single-field text-area w-input" id="contact-message" maxlength="2000" minlength="10" name="message" placeholder="Tell us what happened, your area, and preferred visit time" required></textarea></div>
                <div aria-hidden="true" class="enquiry-honeypot"><label for="contact-company">Company website</label><input autocomplete="off" id="contact-company" name="company" tabindex="-1" type="text" /></div>
                <div class="cf-turnstile" data-action="turnstile-spin-v2" data-sitekey={turnstileSiteKey}></div>
                <input class="form-button w-button" data-wait="Please wait..." type="submit" value="Send Enquiry" />
              </form>
              <div aria-live="polite" class="w-form-done" role="status"><div>Thank you. Your enquiry was sent successfully.</div></div>
              <div aria-live="assertive" class="w-form-fail" role="alert"><div>We could not send your enquiry. Please try again or call us directly.</div></div>
            </div>
            <aside class="contact-response-note" aria-label="Response time note">
              <span class="contact-response-icon" aria-hidden="true">
                <svg width="42" height="42" viewBox="0 0 24 24">
                  <path d="M7 2h10a3 3 0 0 1 3 3v15.5a1 1 0 0 1-1.5.9L12 18l-6.5 3.9a1 1 0 0 1-1.5-.9V5a3 3 0 0 1 3-3Zm0 2a1 1 0 0 0-1 1v13.2l5.5-3.3a1 1 0 0 1 1 0l5.5 3.3V5a1 1 0 0 0-1-1H7Zm2 4h6v2H9V8Zm0 4h4v2H9v-2Z" fill="currentColor"/>
                </svg>
              </span>
              <p class="contact-response-title">We aim to respond within 1 business day.</p>
              <p class="contact-response-text">For urgent matters, please contact us via WhatsApp.</p>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="location-section section-padding">
    <div class="w-layout-blockcontainer container w-container">
      <div class="contact-service-area">
        <div class="contact-service-area-content">
          <div class="title-wrapper style-02">
            <h2 class="section-title">Service Area</h2>
            <p class="section-subtitle">{brand.serviceArea}</p>
          </div>
          <a class="button-style-03 w-button" href="/service">Explore services</a>
        </div>
        <div class="contact-service-area-map">
          <img alt="Perfect Roofing & Waterproofing service area map covering Kuala Lumpur, Selangor and Klang Valley" class="map-image" loading="lazy" src="/images/map.png" />
          <div class="service-map-overlay-compact">
            <div class="service-map-panel">
              <div class="service-map-heading">
                <p>Services Covered</p>
              </div>
              <div class="service-map-mini-list">
                <span><svg width="14" height="14" viewBox="0 0 24 24"><path d={iconPaths.roof} fill="currentColor" /></svg>Roof Repair & Replacement</span>
                <span><svg width="14" height="14" viewBox="0 0 24 24"><path d={iconPaths.roof} fill="currentColor" /></svg>Roof Installation & Maintenance</span>
                <span><svg width="14" height="14" viewBox="0 0 24 24"><path d={iconPaths.waterproofing} fill="currentColor" /></svg>Waterproofing & PU Injection</span>
              </div>
            </div>
            <div class="service-map-badge-row">
              <span>Service Areas</span>
              <span>Our Service Hub</span>
            </div>
            <p class="service-map-disclaimer">Illustrative service area map. Coverage shown for service reference only.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA />

  <script>
    document.querySelectorAll("[data-copy-value]").forEach((button) => {
      button.addEventListener("click", async () => {
        const value = button.getAttribute("data-copy-value") || "";
        if (!value) return;
        await navigator.clipboard.writeText(value);
        button.classList.add("copied");
        window.setTimeout(() => button.classList.remove("copied"), 1200);
      });
    });
  </script>
</BaseLayout>
