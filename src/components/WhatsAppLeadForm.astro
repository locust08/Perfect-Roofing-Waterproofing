payload.referrer_url=document.referrer||'';try{payload.referrer_domain=document.referrer?new URL(document.referrer).hostname:'';}catch(e){}payload.all_query_params_json=JSON.stringify(Object.fromEntries(q));payload.all_utm_json=JSON.stringify(Object.fromEntries(Array.from(q).filter(function(pair){return pair[0].indexOf('utm_')===0;})));

['utm_source','utm_medium','utm_campaign','utm_id','utm_term','utm_content','utm_source_platform','gclid','gbraid','wbraid','fbclid','msclkid','ttclid'].forEach(function(key){payload[key]=q.get(key)||'';});

