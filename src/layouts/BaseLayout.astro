---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppLeadForm from "../components/WhatsAppLeadForm.astro";
import { brand } from "../data/site";

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = Astro.url.pathname } = Astro.props;
const canonical = brand.productionUrl ? new URL(path, brand.productionUrl).toString() : undefined;
const openGraphImage = brand.productionUrl
  ? new URL("/images/red-roof-2-2-p-800.png", brand.productionUrl).toString()
  : undefined;
---
<html data-wf-page="6a13c437500bdc9bd5f69501" data-wf-site="6a13c435500bdc9bd5f694bc" lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <link href="/css/normalize.css" rel="stylesheet" type="text/css" />
    <link href="/css/webflow.css" rel="stylesheet" type="text/css" />
    <link href="/css/plumber-roofily.webflow.css" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="anonymous" href="https://fonts.gstatic.com" rel="preconnect" />
    <script src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
    <script type="text/javascript">WebFont.load({ google: { families: ["Bebas Neue:400","Geist:400,500,600,700,800,900"] } });</script>
    <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/images/favicon.png" rel="shortcut icon" type="image/png" />
    {canonical && <link href={canonical} rel="canonical" />}
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    {openGraphImage && <meta content={openGraphImage} property="og:image" />}
    <meta content="website" property="og:type" />
    {canonical && <meta content={canonical} property="og:url" />}
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-WV87F7SC');
    </script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WV87F7SC" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <slot />
    <Footer />
    <WhatsAppLeadForm />
    <script crossorigin="anonymous" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6a13c435500bdc9bd5f694bc" type="text/javascript"></script>
    <script src="/js/webflow.js" type="text/javascript"></script>
    <script type="module" src="/js/analytics.js"></script>
    <script>
      import posthog from "posthog-js";
      import { initializePostHog } from "../scripts/posthog";

      void initializePostHog({ client: posthog, fetcher: window.fetch.bind(window), browserWindow: window });
    </script>
    <script>
      import { attributionForConversion, captureFirstTouchAttribution } from "../scripts/attribution";

      (() => {
        const trackEvent = (eventName, details) => window.PerfectRoofingAnalytics?.trackEvent(eventName, details);
        const widgets = new WeakMap();
        const unavailableStorage = { getItem: () => null, setItem: () => {} };
        let storage = unavailableStorage;
        try {
          storage = window.sessionStorage;
        } catch {
          // Forms continue to work if session storage is unavailable.
        }
        const firstTouchAttribution = captureFirstTouchAttribution({
          storage,
          pathname: window.location.pathname,
          search: window.location.search,
          referrer: document.referrer,
        });
        const formDetails = (form) => ({
          form_id: form.getAttribute("name") || "enquiry-form",
          conversion_type: form.querySelector('[name="form_type"]')?.value || "",
        });

        const statusElements = (form) => {
          const wrapper = form.closest(".w-form");
          return {
            success: wrapper?.querySelector(".w-form-done"),
            error: wrapper?.querySelector(".w-form-fail"),
          };
        };

        const showStatus = (form, state, message) => {
          const status = statusElements(form);
          if (status.success) status.success.style.display = state === "success" ? "block" : "none";
          if (status.error) {
            const content = status.error.querySelector("div");
            if (content && message) content.textContent = message;
            status.error.style.display = state === "error" ? "block" : "none";
          }
          form.style.display = state === "success" ? "none" : "block";
        };

        const renderWidgets = () => {
          if (!window.turnstile) return;
          document.querySelectorAll("[data-enquiry-form] .cf-turnstile").forEach((element) => {
            if (widgets.has(element)) return;
            const widgetId = window.turnstile.render(element, {
              sitekey: element.dataset.sitekey,
              action: element.dataset.action,
              theme: "auto",
              "error-callback": () => {
                const form = element.closest("form");
                if (form) showStatus(form, "error", "The security check could not load. Please refresh and try again.");
              },
            });
            widgets.set(element, widgetId);
          });
        };

        window.onTurnstileReady = () => {
          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", renderWidgets, { once: true });
          } else {
            renderWidgets();
          }
        };

        document.addEventListener("submit", async (event) => {
          const form = event.target.closest?.("[data-enquiry-form]");
          if (!form) return;
          event.preventDefault();
          event.stopImmediatePropagation();
          const details = formDetails(form);
          let errorTracked = false;

          const submit = form.querySelector('[type="submit"]');
          const originalLabel = submit?.value || submit?.textContent || "Submit";
          if (submit) {
            submit.disabled = true;
            if ("value" in submit) submit.value = submit.dataset.wait || "Please wait...";
            else submit.textContent = submit.dataset.wait || "Please wait...";
          }
          showStatus(form, "idle");

          try {
            const formData = new FormData(form);
            const payload = Object.fromEntries(formData.entries());
            payload.page_path = window.location.pathname;
            payload.attribution = attributionForConversion(
              firstTouchAttribution,
              window.location.pathname,
              String(payload.form_type || ""),
            );
            trackEvent("form_submit", details);
            const response = await fetch(form.action, {
              method: "POST",
              credentials: "same-origin",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const result = await response.json();
            if (!response.ok || result.ok !== true) {
              const errorCode = typeof result.error === "string" ? result.error : "submission_failed";
              trackEvent("form_error", { ...details, error_code: errorCode });
              errorTracked = true;
              const message = result.error === "rate_limited"
                ? "Too many attempts. Please wait one minute and try again."
                : result.error === "turnstile_failed"
                  ? "The security check expired or failed. Please try again."
                  : "We could not send your enquiry. Please check the form and try again.";
              throw new Error(message);
            }

            trackEvent("form_success", {
              ...details,
              lead_id: typeof result.lead_id === "string" ? result.lead_id : "",
            });
            form.reset();
            const widget = form.querySelector(".cf-turnstile");
            const widgetId = widget ? widgets.get(widget) : undefined;
            if (widgetId !== undefined) window.turnstile?.reset(widgetId);
            showStatus(form, "success");
          } catch (error) {
            if (!errorTracked) {
              trackEvent("form_error", { ...details, error_code: "request_failed" });
            }
            showStatus(form, "error", error instanceof Error ? error.message : "We could not send your enquiry. Please try again.");
          } finally {
            if (submit) {
              submit.disabled = false;
              if ("value" in submit) submit.value = originalLabel;
              else submit.textContent = originalLabel;
            }
          }
        }, true);

      })();
    </script>
    <script async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileReady&amp;render=explicit"></script>
    <script is:inline>
      (() => {
        const animatedSelectors = [
          ".section-header",
          ".title-wrapper",
          ".about-image",
          ".about-content",
          ".about-card-wrapper",
          ".about-cta",
          ".single-service",
          ".single-choose-us-card",
          ".gallery-category-grid",
          ".gallery-featured-grid",
          ".gallery-workflow-grid",
          ".project-gallery",
          ".metrics",
          ".how-it-works-content-wrapper",
          ".process-image-wrapper",
          ".roof-products",
          ".single-roof-products",
          ".testimonial-slider",
          ".faq-content-wrapper",
          ".cta-content-wrapper",
          ".contact-card-wrapper",
          ".contact-form-wrapper",
          ".service-details-content-wrapper",
          ".footer-content-wrapper"
        ];

        const elements = [...document.querySelectorAll(animatedSelectors.join(","))];
        if (!elements.length || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        document.documentElement.classList.add("bc-motion-ready");
        elements.forEach((element, index) => {
          element.classList.add("bc-animate");
          element.style.transitionDelay = `${Math.min(index % 6, 5) * 70}ms`;
        });

        if (!("IntersectionObserver" in window)) {
          elements.forEach((element) => element.classList.add("bc-visible"));
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("bc-visible");
            observer.unobserve(entry.target);
          });
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.12 });

        elements.forEach((element) => observer.observe(element));
      })();
    </script>
    <script is:inline>
      (() => {
        const counters = [...document.querySelectorAll(".js-count[data-count-target]")];
        if (!counters.length || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const animateCounter = (counter) => {
          if (counter.dataset.counted === "true") return;
          counter.dataset.counted = "true";

          const target = Number(counter.dataset.countTarget || 0);
          const suffix = counter.dataset.countSuffix || "";
          const duration = Number(counter.dataset.countDuration || 900);
          const startTime = performance.now();

          const tick = (now) => {
            const progress = Math.min((now - startTime) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            counter.textContent = `${Math.round(target * eased)}${suffix}`;
            if (progress < 1) requestAnimationFrame(tick);
          };

          requestAnimationFrame(tick);
        };

        if (!("IntersectionObserver" in window)) {
          counters.forEach(animateCounter);
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            animateCounter(entry.target);
            observer.unobserve(entry.target);
          });
        }, { rootMargin: "0px 0px -10% 0px", threshold: 0.4 });

        counters.forEach((counter) => observer.observe(counter));
      })();
    </script>
    <script is:inline>
      (() => {
        const sliders = document.querySelectorAll(".testimonial-slider");
        if (!sliders.length) return;

        sliders.forEach((slider) => {
          let startX = 0;
          let startY = 0;
          let tracking = false;
          let moved = false;
          let dragSource = "";
          let startScroll = 0;

          const syncDots = () => {
            const dots = [...slider.querySelectorAll(".w-slider-dot")];
            const slide = slider.querySelector(".w-slide");
            if (!dots.length || !slide) return;
            const slideWidth = slide.getBoundingClientRect().width || 1;
            const activeIndex = Math.max(0, Math.min(dots.length - 1, Math.round(slider.scrollLeft / slideWidth)));
            dots.forEach((dot, index) => dot.classList.toggle("w-active", index === activeIndex));
          };

          const snapToNearestSlide = () => {
            const slide = slider.querySelector(".w-slide");
            if (!slide) return;
            const slideWidth = slide.getBoundingClientRect().width || 1;
            const target = Math.round(slider.scrollLeft / slideWidth) * slideWidth;
            if (typeof slider.scrollTo === "function") {
              slider.scrollTo({ left: target, behavior: "smooth" });
            } else {
              slider.scrollLeft = target;
            }
            window.setTimeout(syncDots, 250);
          };

          const pointFromEvent = (event) => {
            const touch = event.changedTouches && event.changedTouches[0];
            return touch || event;
          };

          const startDrag = (event, source) => {
            if (event.button !== undefined && event.button !== 0) return;
            const point = pointFromEvent(event);
            tracking = true;
            moved = false;
            dragSource = source;
            startX = point.clientX;
            startY = point.clientY;
            startScroll = slider.scrollLeft;
            slider.classList.add("is-dragging");
          };

          const updateDrag = (event) => {
            if (!tracking) return;
            const point = pointFromEvent(event);
            const deltaX = point.clientX - startX;
            const deltaY = point.clientY - startY;
            if (Math.abs(deltaX) > 8 && Math.abs(deltaX) > Math.abs(deltaY)) {
              moved = true;
              if (event.cancelable) event.preventDefault();
              slider.scrollLeft = startScroll - deltaX;
              syncDots();
            }
          };

          const finishDrag = (event) => {
            if (!tracking) return;
            const point = pointFromEvent(event);
            tracking = false;
            dragSource = "";
            slider.classList.remove("is-dragging");
            const deltaX = point.clientX - startX;
            const deltaY = point.clientY - startY;
            if (!moved || Math.abs(deltaX) < 50 || Math.abs(deltaX) < Math.abs(deltaY)) return;
            snapToNearestSlide();
          };

          slider.addEventListener("dragstart", (event) => event.preventDefault());
          slider.addEventListener("pointerdown", (event) => startDrag(event, "pointer"), true);
          slider.addEventListener("pointermove", updateDrag, true);
          slider.addEventListener("pointerup", finishDrag, true);
          slider.addEventListener("mousedown", (event) => startDrag(event, "mouse"), true);
          window.addEventListener("mousemove", (event) => {
            if (dragSource === "mouse") updateDrag(event);
          }, true);
          window.addEventListener("mouseup", (event) => {
            if (dragSource === "mouse") finishDrag(event);
          }, true);
          slider.addEventListener("touchstart", (event) => startDrag(event, "touch"), { capture: true, passive: true });
          slider.addEventListener("touchmove", (event) => {
            if (dragSource === "touch") updateDrag(event);
          }, { capture: true, passive: false });
          slider.addEventListener("touchend", (event) => {
            if (dragSource === "touch") finishDrag(event);
          }, true);
          slider.addEventListener("pointercancel", () => {
            tracking = false;
            dragSource = "";
            slider.classList.remove("is-dragging");
          });
          slider.addEventListener("lostpointercapture", () => {
            tracking = false;
            dragSource = "";
            slider.classList.remove("is-dragging");
          });
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const buttons = document.querySelectorAll("[data-copy]");
        if (!buttons.length) return;

        const fallbackCopy = (value) => {
          const input = document.createElement("textarea");
          input.value = value;
          input.setAttribute("readonly", "");
          input.style.position = "absolute";
          input.style.left = "-9999px";
          document.body.appendChild(input);
          input.select();
          document.execCommand("copy");
          input.remove();
        };

        buttons.forEach((button) => {
          button.addEventListener("click", async () => {
            const value = button.getAttribute("data-copy");
            if (!value) return;
            try {
              if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(value);
              } else {
                fallbackCopy(value);
              }
              button.classList.add("is-copied");
              window.setTimeout(() => button.classList.remove("is-copied"), 900);
            } catch {
              fallbackCopy(value);
            }
          });
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const getFaqs = () => [...document.querySelectorAll(".single-faq")];

        const setOpen = (faq, open) => {
          const question = faq.querySelector(".question");
          const answer = faq.querySelector(".answer");
          faq.classList.toggle("w--open", open);
          question?.classList.toggle("w--open", open);
          answer?.classList.toggle("w--open", open);
          question?.setAttribute("aria-expanded", String(open));
        };

        const initFaqs = () => {
          getFaqs().forEach((faq) => {
            const question = faq.querySelector(".question");
            if (!question) return;
            question.setAttribute("role", "button");
            question.setAttribute("tabindex", "0");
            question.setAttribute("aria-expanded", faq.classList.contains("w--open") ? "true" : "false");
          });
        };

        const toggleFaq = (question) => {
          const faq = question.closest(".single-faq");
          if (!faq) return;
          const shouldOpen = !faq.classList.contains("w--open");
          getFaqs().forEach((item) => setOpen(item, false));
          setOpen(faq, shouldOpen);
        };

        document.addEventListener("click", (event) => {
          const question = event.target.closest(".single-faq .question");
          if (!question) return;
          event.preventDefault();
          event.stopPropagation();
          toggleFaq(question);
        }, true);

        document.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          const question = event.target.closest(".single-faq .question");
          if (!question) return;
          event.preventDefault();
          event.stopPropagation();
          toggleFaq(question);
        }, true);

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initFaqs);
        } else {
          initFaqs();
        }
      })();
    </script>
    <style is:global>
      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      select:focus-visible,
      textarea:focus-visible,
      [tabindex]:focus-visible,
      .w-nav-button:focus-visible,
      .w-dropdown-toggle:focus-visible,
      .w-input:focus-visible,
      .w-select:focus-visible {
        outline: 3px solid #0f5d4e;
        outline-offset: 3px;
      }

      .nav-trigger.w-nav-button,
      .question.w-dropdown-toggle {
        appearance: none;
        background: transparent;
        border: 0;
        color: inherit;
        font: inherit;
        text-align: inherit;
      }

      .enquiry-honeypot {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    </style>
  </body>
</html>
